    <worksheet name='Sheet 3'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Times New Roman'>The health / social risk index for each of the top advertising brands</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='advertisers cleaned+' name='federated.0zrpe950j3ij2p120e8wm0rf95t5' />
          </datasources>
          <datasource-dependencies datasource='federated.0zrpe950j3ij2p120e8wm0rf95t5'>
            <column caption='RISK SCORE' datatype='integer' name='[Calculation_0594837134671872]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [risk_level]&#13;&#10;WHEN &apos;Extremely High&apos; THEN 10&#13;&#10;WHEN &apos;High&apos; THEN 7&#13;&#10;WHEN &apos;Moderate&apos; THEN 5&#13;&#10;WHEN &apos;Low&apos; THEN 2&#13;&#10;END' />
            </column>
            <column caption='INFLUENCE SCORE' datatype='integer' name='[Calculation_0594837134827521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [celebrity_influence]&#13;&#10;WHEN &apos;Extremely High&apos; THEN 5&#13;&#10;WHEN &apos;Very High&apos; THEN 4&#13;&#10;WHEN &apos;High&apos; THEN 3&#13;&#10;WHEN &apos;Medium&apos; THEN 2&#13;&#10;WHEN &apos;Moderate&apos; THEN 2&#13;&#10;END' />
            </column>
            <column caption='RISK INDEX' datatype='real' name='[Calculation_0594837135036418]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ROUND(100 * (0.7 * [Calculation_0594837134671872] / 10 + 0.3 * [Calculation_0594837134827521] / 5), 1)' />
            </column>
            <column caption='RISK BAND' datatype='string' name='[Calculation_0594837135872003]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0594837135036418] &gt;= 70 THEN &apos;High&apos;&#13;&#10;ELSEIF [Calculation_0594837135036418] &gt;= 40 THEN &apos;Medium&apos;&#13;&#10;ELSE &apos;Low&apos;&#13;&#10;END' />
            </column>
            <column caption='Advertiser Brand' datatype='string' name='[advertiser_brand]' role='dimension' type='nominal' />
            <column caption='Celebrity Influence' datatype='string' name='[celebrity_influence]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0594837135872003]' derivation='None' name='[none:Calculation_0594837135872003:nk]' pivot='key' type='nominal' />
            <column-instance column='[advertiser_brand]' derivation='None' name='[none:advertiser_brand:nk]' pivot='key' type='nominal' />
            <column caption='Risk Level' datatype='string' name='[risk_level]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0594837135036418]' derivation='Sum' name='[sum:Calculation_0594837135036418:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.0zrpe950j3ij2p120e8wm0rf95t5].[none:advertiser_brand:nk]' direction='DESC' using='[federated.0zrpe950j3ij2p120e8wm0rf95t5].[sum:Calculation_0594837135036418:qk]' />
          <aggregation value='true' />
        </view>
        <style />
