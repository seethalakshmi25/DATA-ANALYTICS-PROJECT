      <aliases enabled='yes' />
      <column caption='RISK SCORE' datatype='integer' name='[Calculation_0594837134671872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [risk_level]&#13;&#10;WHEN &apos;Extremely High&apos; THEN 10&#13;&#10;WHEN &apos;High&apos; THEN 7&#13;&#10;WHEN &apos;Moderate&apos; THEN 5&#13;&#10;WHEN &apos;Low&apos; THEN 2&#13;&#10;END' />
      </column>
      <column caption='INFLUENCE SCORE' datatype='integer' name='[Calculation_0594837134827521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [celebrity_influence]&#13;&#10;WHEN &apos;Extremely High&apos; THEN 5&#13;&#10;WHEN &apos;Very High&apos; THEN 4&#13;&#10;WHEN &apos;High&apos; THEN 3&#13;&#10;WHEN &apos;Medium&apos; THEN 2&#13;&#10;WHEN &apos;Moderate&apos; THEN 2&#13;&#10;END' />
      </column>
      <column caption='RISK INDEX' datatype='real' name='[Calculation_0594837135036418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(100 * (0.7 * [Calculation_0594837134671872] / 10 + 0.3 * [Calculation_0594837134827521] / 5), 1)' />
      </column>
      <column caption='RISK BAND' datatype='string' name='[Calculation_0594837135872003]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0594837135036418] &gt;= 70 THEN &apos;High&apos;&#13;&#10;ELSEIF [Calculation_0594837135036418] &gt;= 40 THEN &apos;Medium&apos;&#13;&#10;ELSE &apos;Low&apos;&#13;&#10;END' />
      </column>
      <column caption='CAGR' datatype='real' name='[Calculation_0594837138984964]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [sector] = &apos;Pan Masala&apos; THEN 0.0323 &#13;&#10;END' />
      </column>
      <column caption='PROJECTED REVENUE' datatype='real' name='[Calculation_0594837139226629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[revenue_cr_mid] * POWER(1 + [Calculation_0594837138984964], 2030 - [fiscal_year])' />
      </column>
      <column caption='PRODUCT GROUP ' datatype='string' name='[Calculation_0594837140930566]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([income_group]), &apos;lower&apos;) THEN &apos;Pan Masala&apos;&#13;&#10;ELSEIF CONTAINS(LOWER([income_group]), &apos;middle&apos;) THEN &apos;Fantasy/Betting&apos;&#13;&#10;END' />
      </column>
      <column caption='HARM %' datatype='real' name='[Calculation_0594837141041159]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0594837140930566] = &apos;Pan Masala&apos; THEN 0.10 ELSE 0.20 &#13;&#10;END' />
      </column>
      <column caption='IMPACTED' datatype='real' name='[Calculation_0594837144891401]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[users_mid_mn] * [Calculation_0594837141041159]' />
      </column>
