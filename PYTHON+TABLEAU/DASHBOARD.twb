      <aliases enabled='yes' />
      <column caption='average AQI' datatype='real' name='[Calculation_0133933475586048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([aqi_value])' />
      </column>
      <column caption='top and bottom' datatype='string' name='[Calculation_0133933478772738]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK([Calculation_0133933475586048],&apos;desc&apos;) &lt;= 5 THEN &quot;Top 5 Highest AQI&quot;&#13;&#10;ELSEIF RANK([Calculation_0133933475586048], &apos;asc&apos;) &lt;= 5 THEN &quot;Bottom 5 Lowest AQI&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='top and bottom prominent pollutants' datatype='string' name='[Calculation_0133933485932548]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK(COUNT([prominent_pollutants]), &apos;desc&apos;) &lt;= 2 THEN &quot;Top 2 Prominent&quot;&#13;&#10;ELSEIF RANK(COUNT([prominent_pollutants]), &apos;asc&apos;) &lt;= 2 THEN &quot;Bottom 2 Prominent&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='DAYS' datatype='string' name='[Calculation_0133933491822598]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;, [date]) = 1 OR DATEPART(&apos;weekday&apos;, [date]) = 7 THEN &quot;Weekend&quot;&#13;&#10;ELSE &quot;Weekday&quot;&#13;&#10;END' />
      </column>
      <column caption='WORST MONTHS' datatype='string' name='[Calculation_0133933498867719]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK(AVG([aqi_value]), &apos;desc&apos;) &lt;= 3 THEN &quot;Worst 3 Months&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='state level aqi' datatype='real' name='[Calculation_0170218064281600]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(MIN([Calculation_0701556731133961]))'>
          <table-calc ordering-field='[federated.1fs56o30r89q7f14gm0i00j5c0jp].[state]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='counting' datatype='integer' name='[Calculation_0701556707188736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([air_quality_status])' />
      </column>
      <column caption='EV registrations' datatype='integer' name='[Calculation_0701556726939651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [fuel] = &quot;Electric(Bov)&quot;&#13;&#10;    OR [fuel] = &quot;Pure Ev&quot;&#13;&#10;    OR [fuel] = &quot;Plug-In Hybrid Ev&quot;&#13;&#10;    OR [fuel] = &quot;Strong Hybrid EV&quot;&#13;&#10;    THEN [value]&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='total reg' datatype='integer' name='[Calculation_0701556727619588]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([value])' />
      </column>
      <column caption='percentile' datatype='real' name='[Calculation_0701556727758853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0701556726939651] / [Calculation_0701556727619588]' />
      </column>
      <column caption='ev adoption rank' datatype='integer' name='[Calculation_0701556728254470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_0701556727758853],&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='area daily aqi' datatype='real' name='[Calculation_0701556731023368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state], [date], [area] :&#13;&#10;    AVG([aqi_value])&#13;&#10;}' />
      </column>
      <column caption='state avg aqi' datatype='real' name='[Calculation_0701556731133961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [state] :&#13;&#10;    AVG([Calculation_0701556731023368])&#13;&#10;}' />
      </column>
      <column caption='ev adoption category' datatype='string' name='[Calculation_0701556731326474]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF RANK_DENSE([Calculation_0701556727758853], &apos;desc&apos;) &lt;= 5&#13;&#10;THEN &quot;High EV Adoption&quot;&#13;&#10;ELSE &quot;Low EV Adoption&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
