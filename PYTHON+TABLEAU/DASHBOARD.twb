              <calculation class='tableau' formula='IF RANK(COUNT([prominent_pollutants]), &apos;desc&apos;) &lt;= 2 THEN &quot;Top 2 Prominent&quot;&#13;&#10;ELSEIF RANK(COUNT([prominent_pollutants]), &apos;asc&apos;) &lt;= 2 THEN &quot;Bottom 2 Prominent&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END'>
